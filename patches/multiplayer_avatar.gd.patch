+## Shows the summoner's Sharingan on this remote avatar while their Uchiha mode is active.
+func set_sharingan_visual(enabled: bool) -> void:
+	if enabled:
+		if network_ragdoll_started:
+			return
+		if sharingan_fx != null and is_instance_valid(sharingan_fx):
+			return
+		if model != null and is_instance_valid(model):
+			sharingan_fx = SHARINGAN_EFFECT_SCRIPT.attach_to(model)
+	else:
+		if sharingan_fx != null and is_instance_valid(sharingan_fx):
+			sharingan_fx.call("detach")
+		sharingan_fx = null
