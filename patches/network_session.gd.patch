+## Replicate the Uchiha Sharingan eye effect through the existing ENet host.
+func broadcast_sharingan_state(enabled: bool) -> void:
+	if not is_active():
+		return
+	var owner_id := multiplayer.get_unique_id()
+	_sharingan_states[owner_id] = enabled
+	if multiplayer.is_server():
+		_broadcast_sharingan_state.rpc(owner_id, enabled)
+	else:
+		_request_sharingan_state.rpc_id(1, enabled)
+
+@rpc("any_peer", "call_remote", "reliable")
+func _request_sharingan_state(enabled: bool) -> void:
+	if not multiplayer.is_server():
+		return
+	var sender := multiplayer.get_remote_sender_id()
+	if not _known_players.has(sender):
+		return
+	_apply_sharingan_state(sender, enabled)
+	_broadcast_sharingan_state.rpc(sender, enabled)
+
+@rpc("authority", "call_remote", "reliable")
+func _broadcast_sharingan_state(peer_id: int, enabled: bool) -> void:
+	_apply_sharingan_state(peer_id, enabled)
+
+func _apply_sharingan_state(peer_id: int, enabled: bool) -> void:
+	_sharingan_states[peer_id] = enabled
+	if peer_id == multiplayer.get_unique_id():
+		return
+	if _avatars.has(peer_id) and is_instance_valid(_avatars[peer_id]):
+		_avatars[peer_id].set_sharingan_visual(enabled)
+
