[gd_resource type="Resource" script_class="QuestDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/quests/quest_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = "letter"
title = "A Letter for Mika"
giver = "elder"
requires = "first_steps"
order = 1
type = "deliver"
target = "scout"
reward_spins = 1
reward_xp = 300
offer = "Scout Mika waits in the east with a letter that needs her answer. Deliver my message to her and come back."
remind = "Scout Mika is at the east end of the cross street. Find her and speak to her."
deliver_text = "A message from the Elder? ...Hm. Tell him I understand. The bandits are a bigger problem than he thinks."
turn = "She understood? Good. Here is something for your trouble."
